# Example environment variables
# Copy this file to .env for local development

# Server WebSocket URL
VITE_SERVER_URL=ws://localhost:2567

# Optional GLB model overrides.
# Files in client/public are served from the site root, so:
# client/public/models/maze-wall.glb -> /models/maze-wall.glb
VITE_MAZE_WALL_MODEL_URL=/models/maze-wall.glb

# Optional per-quadrant wall variants.
# If one of these is missing, the game falls back to VITE_MAZE_WALL_MODEL_URL.
VITE_MAZE_WALL_MODEL_URL_1=/models/maze-wall-1.glb
VITE_MAZE_WALL_MODEL_URL_2=/models/maze-wall-2.glb
VITE_MAZE_WALL_MODEL_URL_3=/models/maze-wall-3.glb
VITE_MAZE_WALL_MODEL_URL_4=/models/maze-wall-4.glb

# VITE_MAZE_PLAYER_MODEL_URL=/models/player.glb
# VITE_MAZE_FLASHLIGHT_MODEL_URL=/models/flashlight.glb
# VITE_EXIT_BARRIER_MODEL_URL=/models/exit-barrier.glb

# Optional floor and sky textures.
# Files in client/public/textures are served as /textures/...
VITE_MAZE_FLOOR_TEXTURE_URL=/textures/floor.jpg
VITE_MAZE_FLOOR_TEXTURE_REPEAT_UNITS=1.8
VITE_MAZE_SKY_TEXTURE_URL=/textures/sky.jpg
VITE_MAZE_SKY_ROTATION_X_DEG=90
VITE_MAZE_SKY_ROTATION_Y_DEG=0
VITE_MAZE_SKY_ROTATION_Z_DEG=0
